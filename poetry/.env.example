# Copy this file to ".env" and drop your real key in.
# Get one at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Reasoning/thinking for models that support it: off | low | medium | high
# (default: off — poem generation doesn't need chain-of-thought)
OPENROUTER_REASONING=off

# Port the local server listens on
PORT=3000
