{
  "version": 2,
  "functions": {
    "api/index.go": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/squire(.*)",
      "dest": "https://squire-archways-projects.vercel.app/squire$1"
    },
    {
      "src": "/$",
      "dest": "/api/index.go"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.go"
    }
  ]
}
